# GreenDesk backend development environment
NODE_ENV=development
PORT=3000

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=greendesk
DATABASE_USER=greendesk
DATABASE_PASSWORD=replace-with-a-local-database-password
DATABASE_LOGGING=false

CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL=15m

# Optional local seeder identity. Supply its password only at command execution time.
GREENDESK_SEED_ADMIN_EMAIL=admin@greendesk.local
