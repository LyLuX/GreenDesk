# Runtime
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=greendesk
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_LOGGING=false

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL=15m
PUBLIC_REGISTRATION_ENABLED=true
TRUSTED_PROXIES=false

# Email sender and SMTP transport
MAIL_ENABLED=false
MAIL_FROM_NAME=GreenDesk
MAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USE_SYSTEM_CA=false
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# SMTP authentication: none, password or oauth2
SMTP_AUTH_TYPE=none
SMTP_USER=
SMTP_PASSWORD=

# OAuth2 authentication. Keep SMTP_PASSWORD empty in this mode.
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
SMTP_OAUTH_ACCESS_TOKEN=
# Optional Unix timestamp in milliseconds for a supplied access token.
SMTP_OAUTH_EXPIRES_AT=
SMTP_OAUTH_ACCESS_URL=
SMTP_OAUTH_SCOPE=

# Account verification
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Request quotas
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_MAX=500
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_EMAIL_VERIFICATION_MAX=10
RATE_LIMIT_REFRESH_MAX=30

# Local development seeder
GREENDESK_SEED_ADMIN_EMAIL=admin@greendesk.local
